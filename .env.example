# Copie para .env e ajuste.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres local do docker compose. Em produção, use a connection string
# do Session pooler do Supabase (veja docs/supabase.md).
DATABASE_URL=postgres://gestao:gestao@localhost:5432/gestao

# Banco usado pelo `npm test`.
TEST_DATABASE_URL=postgres://gestao:gestao@localhost:5432/gestao_test

# Opcional: token do GitHub (sem permissões extras) para passar de 60 para
# 5000 requisições por hora nas submissões. Veja docs/submissao.md.
# GITHUB_TOKEN=
